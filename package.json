{
  "name": "coffee-roulette",
  "version": "0.1.0",
  "description": "Slack app for automatic coworker coffee chat introductions",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "node -r ts-node/register src/db/migrate.ts"
  },
  "dependencies": {
    "@slack/bolt": "^3.17.1",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
