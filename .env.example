# Slack App Credentials
# Found under Basic Information / OAuth & Permissions on https://api.slack.com/apps
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Any long random string — used to sign the OAuth `state` parameter.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLACK_STATE_SECRET=

# Local development only (Socket Mode) — not used in production, where
# the OAuth install flow resolves each workspace's bot token instead.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Database
DATABASE_URL=postgresql://localhost:5432/coffee_roulette

# App
PORT=3000
NODE_ENV=development
